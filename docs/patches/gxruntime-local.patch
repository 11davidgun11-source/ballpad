+// A1 quick-boot: save/restore the shadow frontend's parsed GX state so a
+// restored guest resumes with the renderer state it expects. The blob is
+// opaque; size via dol_aurora_frontend_save_state(nullptr, &size).
+bool dol_aurora_frontend_save_state(void* dst, uint32_t* size) {
+    if (size != nullptr)
+        *size = g_shadow_frontend_enabled
+                    ? dol_gx_recomp_save_state_size()
+                    : 0u;
+    if (dst == nullptr || !g_shadow_frontend_enabled)
+        return g_shadow_frontend_enabled;
+    return dol_gx_recomp_save_state(&g_shadow_frontend.state(),
+                                    static_cast<uint8_t*>(dst));
+}
+
+bool dol_aurora_frontend_restore_state(const void* src, uint32_t size) {
+    if (src == nullptr || !g_shadow_frontend_enabled)
+        return false;
+    if (size < dol_gx_recomp_save_state_size())
+        return false;
+    g_shadow_frontend_failed = false;
+    if (!dol_gx_recomp_restore_state(&g_shadow_frontend.state(),
+                                     static_cast<const uint8_t*>(src)))
+        return false;
+
+    // QuickBoot restores the parser's CP array table, but the gxcore consumer
+    // owns a second copy used to resolve indexed vertex spans. A fresh process
+    // starts that table empty; leaving it empty makes character meshes fetch
+    // guest RAM[0] at stride 0 while direct/static geometry still looks fine.
+    // Restore these directly rather than synthesizing packets: packet sequence
+    // numbers belong to the live frontend, and consuming fake ones would make
+    // its next real packet look stale/out of order.
+    if (g_gx_core_enabled)
+        g_core_sink.restore_frontend_bindings(g_shadow_frontend.state());
+    return true;
+}
