@@ -62,4 +62,62 @@ void GxCoreState::apply(const ar::RenderStatePacket& state) {
   }
 }
 
+// A1 quick-boot: serialize the applied register state. POD image, opaque;
+// the draw-plan derivation re-reads these fields directly after restore.
+std::uint32_t GxCoreState::save(const GxCoreState* state, void* dst,
+                                std::uint32_t* size) {
+  if (size != nullptr)
+    *size = (std::uint32_t)(sizeof(state->bp_regs_) + sizeof(state->bp_valid_) +
+                            sizeof(state->tev_color_) +
+                            sizeof(state->konst_color_) + sizeof(state->vcd_lo_) +
+                            sizeof(state->vcd_hi_) +
+                            sizeof(state->vcd_lo_valid_) +
+                            sizeof(state->vcd_hi_valid_) +
+                            sizeof(state->vat_) + sizeof(state->vat_valid_));
+  if (dst == nullptr || state == nullptr)
+    return 0u;
+  std::uint8_t* p = static_cast<std::uint8_t*>(dst);
+  auto wr = [&p](const void* src, std::size_t bytes) {
+    std::memcpy(p, src, bytes);
+    p += bytes;
+  };
+  wr(state->bp_regs_, sizeof(state->bp_regs_));
+  wr(state->bp_valid_, sizeof(state->bp_valid_));
+  wr(state->tev_color_, sizeof(state->tev_color_));
+  wr(state->konst_color_, sizeof(state->konst_color_));
+  wr(&state->vcd_lo_, sizeof(state->vcd_lo_));
+  wr(&state->vcd_hi_, sizeof(state->vcd_hi_));
+  wr(&state->vcd_lo_valid_, sizeof(state->vcd_lo_valid_));
+  wr(&state->vcd_hi_valid_, sizeof(state->vcd_hi_valid_));
+  wr(state->vat_, sizeof(state->vat_));
+  wr(state->vat_valid_, sizeof(state->vat_valid_));
+  return (std::uint32_t)(p - static_cast<std::uint8_t*>(dst));
+}
+
+bool GxCoreState::restore(GxCoreState* state, const void* src,
+                          std::uint32_t size) {
+  if (state == nullptr || src == nullptr)
+    return false;
+  std::uint32_t expected = 0u;
+  save(nullptr, nullptr, &expected);
+  if (size != expected)
+    return false;
+  const std::uint8_t* p = static_cast<const std::uint8_t*>(src);
+  auto rd = [&p](void* dst, std::size_t bytes) {
+    std::memcpy(dst, p, bytes);
+    p += bytes;
+  };
+  rd(state->bp_regs_, sizeof(state->bp_regs_));
+  rd(state->bp_valid_, sizeof(state->bp_valid_));
+  rd(state->tev_color_, sizeof(state->tev_color_));
+  rd(state->konst_color_, sizeof(state->konst_color_));
+  rd(&state->vcd_lo_, sizeof(state->vcd_lo_));
+  rd(&state->vcd_hi_, sizeof(state->vcd_hi_));
+  rd(&state->vcd_lo_valid_, sizeof(state->vcd_lo_valid_));
+  rd(&state->vcd_hi_valid_, sizeof(state->vcd_hi_valid_));
+  rd(state->vat_, sizeof(state->vat_));
+  rd(state->vat_valid_, sizeof(state->vat_valid_));
+  return true;
+}
+
 } // namespace gxruntime::gxcore
