+                sizeof(u16) + sizeof(u8)) +               /* position matrices */
+           DOL_GX_RECOMP_NORMAL_MATRIX_COUNT *
+               (DOL_GX_RECOMP_NORMAL_MATRIX_WORDS * sizeof(f32) +
+                sizeof(u16)) +                            /* normal matrices */
+           2u * sizeof(u16) +                             /* last xf base/count */
+           sizeof(u8) + 6u * sizeof(f32) + sizeof(u32) +  /* projection */
+           sizeof(u8) + 6u * sizeof(f32) +                /* viewport */
+           DOL_GX_RECOMP_LIGHT_COUNT *
+               (DOL_GX_RECOMP_LIGHT_WORDS * sizeof(u32) +
+                sizeof(u16)) +                            /* lights */
+           DOL_GX_RECOMP_CHAN_REG_COUNT * sizeof(u32) +
+               sizeof(u16) +                              /* chan regs */
+           DOL_GX_RECOMP_TEX_MATRIX_COUNT *
+               (DOL_GX_RECOMP_TEX_MATRIX_WORDS * sizeof(f32) +
+                sizeof(u16)) +                            /* tex matrices */
+           DOL_GX_RECOMP_POST_MATRIX_ROWS *
+               (DOL_GX_RECOMP_POST_MATRIX_WORDS * sizeof(f32) +
+                sizeof(u8)) +                             /* post matrices */
+           sizeof(u32) + sizeof(u8) +                     /* dualtex */
+           DOL_GX_RECOMP_XF_REG_COUNT * sizeof(u32) +
+               sizeof(u64) +                              /* xf regs */
+           (u32)sizeof(DolGxRecompCopyState) +            /* copy (raw) */
+           DOL_GX_RECOMP_MAX_FIFO_BYTES;                  /* fifo bytes */
