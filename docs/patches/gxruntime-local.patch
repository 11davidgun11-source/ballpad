+bool dol_aurora_gxcore_save_state(void* dst, uint32_t* size) {
+    if (size != nullptr)
+        *size = 0u;
+    if (g_gx_core_enabled)
+        return g_core_sink.save_state(dst, size) != 0u || dst == nullptr;
+    return false;
+}
+
+bool dol_aurora_gxcore_restore_state(const void* src, uint32_t size) {
+    if (!g_gx_core_enabled || src == nullptr)
