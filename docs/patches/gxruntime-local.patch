+    restored.restore_array_binding(3u, true, 0x011D27A0u, true, 12u);
+    restored.restore_cull_all(true);
+    assert(restored.array(3u).base_valid);
+    assert(restored.array(3u).base == 0x011D27A0u);
+    assert(restored.array(3u).stride_valid);
+    assert(restored.array(3u).stride == 12u);
+    assert(restored.cull_all());
+
+    ConsumingAuroraRenderSink invalid;
+    RenderPacket draw{};
+    draw.kind = RenderPacketKind::Draw;
+    draw.sequence = 1u;
+    draw.draw.vertex_count = 3u;
+    draw.draw.vertex_size = 1u;
+    assert(invalid.submit_packet(draw));
+    RenderPacket span{};
+    span.kind = RenderPacketKind::Resource;
+    span.sequence = 2u;
+    span.resource.kind = RenderResourceKind::IndexedArraySpan;
+    span.resource.index = 0u;
+    span.resource.size = 3u;
+    span.resource.count = 3u;
+    assert(!invalid.submit_packet(span));
+    assert(std::strcmp(invalid.failure_reason(),
