+
+static u32 gx_recomp_state_size(void) {
+    return (u32)sizeof(GxRecompSaveHeader) +
+           2u * sizeof(u32) + 2u +                        /* vcd */
+           3u * DOL_GX_RECOMP_VERTEX_FORMATS *
