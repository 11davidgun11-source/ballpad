+}
+
+bool dol_gx_recomp_save_state(const DolGxRecompState* gx, void* dst) {
+    if (gx == NULL || dst == NULL)
+        return false;
+    u8* p = (u8*)dst;
+    GxRecompSaveHeader h;
+    h.magic = GXST_MAGIC;
+    h.version = GXST_VERSION;
+    h.size = gx_recomp_state_size();
+    h.fifo_bytes = gx->fifo.size;
+    p = st_write(p, &h, sizeof h);
+    p = st_write(p, &gx->vcd_lo, sizeof gx->vcd_lo);
+    p = st_write(p, &gx->vcd_hi, sizeof gx->vcd_hi);
+    u8 vb = gx->vcd_lo_valid ? 1u : 0u;
+    p = st_write(p, &vb, 1);
+    vb = gx->vcd_hi_valid ? 1u : 0u;
+    p = st_write(p, &vb, 1);
+    p = st_write(p, gx->vat_group0, sizeof gx->vat_group0);
+    p = st_write(p, gx->vat_group1, sizeof gx->vat_group1);
+    p = st_write(p, gx->vat_group2, sizeof gx->vat_group2);
+    for (u32 i = 0; i < DOL_GX_RECOMP_VERTEX_FORMATS; ++i) {
+        vb = gx->vat_group0_valid[i] ? 1u : 0u;
+        p = st_write(p, &vb, 1);
+        vb = gx->vat_group1_valid[i] ? 1u : 0u;
+        p = st_write(p, &vb, 1);
+        vb = gx->vat_group2_valid[i] ? 1u : 0u;
+        p = st_write(p, &vb, 1);
+    }
+    p = st_write(p, gx->arrays, sizeof gx->arrays);
+    vb = gx->cull_all ? 1u : 0u;
+    p = st_write(p, &vb, 1);
+    p = st_write(p, &gx->matrix_index_a, sizeof gx->matrix_index_a);
+    p = st_write(p, &gx->current_pn_matrix, sizeof gx->current_pn_matrix);
+    p = st_write(p, gx->bp_regs, sizeof gx->bp_regs);
+    for (u32 i = 0; i < 256u; ++i) {
+        vb = gx->bp_valid[i] ? 1u : 0u;
+        p = st_write(p, &vb, 1);
+    }
+    p = st_write(p, gx->position_matrices, sizeof gx->position_matrices);
+    p = st_write(p, gx->position_matrix_word_mask,
+                 sizeof gx->position_matrix_word_mask);
+    for (u32 i = 0; i < DOL_GX_RECOMP_POSITION_MATRIX_COUNT; ++i) {
+        vb = gx->position_matrix_valid[i] ? 1u : 0u;
+        p = st_write(p, &vb, 1);
+    }
+    p = st_write(p, gx->normal_matrices, sizeof gx->normal_matrices);
+    p = st_write(p, gx->normal_matrix_word_mask,
+                 sizeof gx->normal_matrix_word_mask);
+    p = st_write(p, &gx->last_xf_base, sizeof gx->last_xf_base);
+    p = st_write(p, &gx->last_xf_count, sizeof gx->last_xf_count);
+    vb = gx->projection_valid ? 1u : 0u;
+    p = st_write(p, &vb, 1);
+    p = st_write(p, gx->projection, sizeof gx->projection);
+    p = st_write(p, &gx->projection_type, sizeof gx->projection_type);
+    vb = gx->viewport_valid ? 1u : 0u;
+    p = st_write(p, &vb, 1);
+    p = st_write(p, gx->viewport, sizeof gx->viewport);
+    p = st_write(p, gx->light_words, sizeof gx->light_words);
+    p = st_write(p, gx->light_word_mask, sizeof gx->light_word_mask);
+    p = st_write(p, gx->chan_regs, sizeof gx->chan_regs);
+    p = st_write(p, &gx->chan_reg_mask, sizeof gx->chan_reg_mask);
+    p = st_write(p, gx->tex_matrices, sizeof gx->tex_matrices);
+    p = st_write(p, gx->tex_matrix_word_mask,
+                 sizeof gx->tex_matrix_word_mask);
+    p = st_write(p, gx->post_matrices, sizeof gx->post_matrices);
+    p = st_write(p, gx->post_matrix_word_mask,
+                 sizeof gx->post_matrix_word_mask);
+    p = st_write(p, &gx->dualtex_info, sizeof gx->dualtex_info);
+    vb = gx->dualtex_valid ? 1u : 0u;
+    p = st_write(p, &vb, 1);
+    p = st_write(p, gx->xf_regs, sizeof gx->xf_regs);
+    p = st_write(p, &gx->xf_reg_mask, sizeof gx->xf_reg_mask);
+    /* Copy state minus the host-pointer range (re-resolved on demand). */
+    DolGxRecompCopyState copy = gx->copy;
+    copy.range_valid = false;
+    p = st_write(p, &copy, sizeof copy);
+    p = st_write(p, gx->fifo.bytes, gx->fifo.size);
+    return true;
+}
+
+bool dol_gx_recomp_restore_state(DolGxRecompState* gx, const void* src) {
+    if (gx == NULL || src == NULL)
+        return false;
+    const u8* p = (const u8*)src;
+    GxRecompSaveHeader h;
+    p = st_read(p, &h, sizeof h);
+    if (h.magic != GXST_MAGIC || h.version != GXST_VERSION ||
+        h.size != gx_recomp_state_size())
+        return false;
+    DolGxRecompState fresh;
+    dol_gx_recomp_init(&fresh, &gx->resolver);
+    p = st_read(p, &fresh.vcd_lo, sizeof fresh.vcd_lo);
+    p = st_read(p, &fresh.vcd_hi, sizeof fresh.vcd_hi);
+    u8 vb;
+    p = st_read(p, &vb, 1);
+    fresh.vcd_lo_valid = vb != 0u;
+    p = st_read(p, &vb, 1);
+    fresh.vcd_hi_valid = vb != 0u;
+    p = st_read(p, fresh.vat_group0, sizeof fresh.vat_group0);
+    p = st_read(p, fresh.vat_group1, sizeof fresh.vat_group1);
+    p = st_read(p, fresh.vat_group2, sizeof fresh.vat_group2);
+    for (u32 i = 0; i < DOL_GX_RECOMP_VERTEX_FORMATS; ++i) {
+        p = st_read(p, &vb, 1);
+        fresh.vat_group0_valid[i] = vb != 0u;
+        p = st_read(p, &vb, 1);
+        fresh.vat_group1_valid[i] = vb != 0u;
+        p = st_read(p, &vb, 1);
+        fresh.vat_group2_valid[i] = vb != 0u;
+    }
+    p = st_read(p, fresh.arrays, sizeof fresh.arrays);
+    p = st_read(p, &vb, 1);
+    fresh.cull_all = vb != 0u;
+    p = st_read(p, &fresh.matrix_index_a, sizeof fresh.matrix_index_a);
+    p = st_read(p, &fresh.current_pn_matrix, sizeof fresh.current_pn_matrix);
+    p = st_read(p, fresh.bp_regs, sizeof fresh.bp_regs);
+    for (u32 i = 0; i < 256u; ++i) {
+        p = st_read(p, &vb, 1);
+        fresh.bp_valid[i] = vb != 0u;
+    }
+    p = st_read(p, fresh.position_matrices, sizeof fresh.position_matrices);
+    p = st_read(p, fresh.position_matrix_word_mask,
+                sizeof fresh.position_matrix_word_mask);
+    for (u32 i = 0; i < DOL_GX_RECOMP_POSITION_MATRIX_COUNT; ++i) {
+        p = st_read(p, &vb, 1);
+        fresh.position_matrix_valid[i] = vb != 0u;
+    }
+    p = st_read(p, fresh.normal_matrices, sizeof fresh.normal_matrices);
+    p = st_read(p, fresh.normal_matrix_word_mask,
+                sizeof fresh.normal_matrix_word_mask);
+    p = st_read(p, &fresh.last_xf_base, sizeof fresh.last_xf_base);
+    p = st_read(p, &fresh.last_xf_count, sizeof fresh.last_xf_count);
+    p = st_read(p, &vb, 1);
+    fresh.projection_valid = vb != 0u;
+    p = st_read(p, fresh.projection, sizeof fresh.projection);
+    p = st_read(p, &fresh.projection_type, sizeof fresh.projection_type);
+    p = st_read(p, &vb, 1);
+    fresh.viewport_valid = vb != 0u;
+    p = st_read(p, fresh.viewport, sizeof fresh.viewport);
+    p = st_read(p, fresh.light_words, sizeof fresh.light_words);
+    p = st_read(p, fresh.light_word_mask, sizeof fresh.light_word_mask);
+    p = st_read(p, fresh.chan_regs, sizeof fresh.chan_regs);
+    p = st_read(p, &fresh.chan_reg_mask, sizeof fresh.chan_reg_mask);
+    p = st_read(p, fresh.tex_matrices, sizeof fresh.tex_matrices);
+    p = st_read(p, fresh.tex_matrix_word_mask,
+                sizeof fresh.tex_matrix_word_mask);
+    p = st_read(p, fresh.post_matrices, sizeof fresh.post_matrices);
+    p = st_read(p, fresh.post_matrix_word_mask,
+                sizeof fresh.post_matrix_word_mask);
+    p = st_read(p, &fresh.dualtex_info, sizeof fresh.dualtex_info);
+    p = st_read(p, &vb, 1);
+    fresh.dualtex_valid = vb != 0u;
+    p = st_read(p, fresh.xf_regs, sizeof fresh.xf_regs);
+    p = st_read(p, &fresh.xf_reg_mask, sizeof fresh.xf_reg_mask);
+    p = st_read(p, &fresh.copy, sizeof fresh.copy);
+    fresh.copy.range_valid = false;
+    if (h.fifo_bytes <= DOL_GX_RECOMP_MAX_FIFO_BYTES) {
+        memcpy(fresh.fifo.bytes, p, h.fifo_bytes);
+        fresh.fifo.size = h.fifo_bytes;
+    }
+    /* Keep this session's resolver; the saved image carried stale pointers. */
+    fresh.resolver = gx->resolver;
+    *gx = fresh;
+    /* Vertex layouts are re-derived from the restored VCD/VAT. */
+    derive_all_vertex_layouts(gx);
+    return true;
+}
