+    HleGxQuickbootState state;
+    memcpy(state.textures, g_textures, sizeof state.textures);
+    memcpy(state.tluts, g_tluts, sizeof state.tluts);
+    memcpy(state.array_address, g_array_address, sizeof state.array_address);
+    memcpy(state.array_stride, g_array_stride, sizeof state.array_stride);
+    memcpy(dst, &state, sizeof state);
+    unsigned textures = 0, tluts = 0, arrays = 0;
+    for (u32 i = 0; i < GX_MAX_TEXTURES; ++i)
+        textures += state.textures[i].valid ? 1u : 0u;
+    for (u32 i = 0; i < GX_MAX_TLUTS; ++i)
+        tluts += state.tluts[i].valid ? 1u : 0u;
+    for (u32 i = 0; i < 32u; ++i)
+        arrays += state.array_address[i] != 0u ? 1u : 0u;
+    fprintf(stderr, "[quickboot-hle] saved textures=%u tluts=%u arrays=%u bytes=%u\n",
+            textures, tluts, arrays, (unsigned)sizeof state);
+    return true;
+}
+
+bool hle_gx_quickboot_restore(CPUState* cpu, const void* src, uint32_t size) {
+    if (cpu == NULL || src == NULL || size != sizeof(HleGxQuickbootState))
+        return false;
+    const HleGxQuickbootState* state = (const HleGxQuickbootState*)src;
+    memcpy(g_textures, state->textures, sizeof g_textures);
+    memcpy(g_tluts, state->tluts, sizeof g_tluts);
+    memcpy(g_array_address, state->array_address, sizeof g_array_address);
+    memcpy(g_array_stride, state->array_stride, sizeof g_array_stride);
+
+    // hle_install intentionally starts a new session with no emitted resource
+    // identity. Reissue every guest-addressed resource into the new Aurora
+    // process; native pointers are resolved only after restored RAM is live.
+    for (u32 i = 0; i < GX_MAX_TEXTURES; ++i)
+        if (g_textures[i].valid)
+            g_textures[i].emitted_version = 0u;
+    for (u32 i = 0; i < GX_MAX_TLUTS; ++i)
+        if (g_tluts[i].valid)
+            g_tluts[i].emitted_version = 0u;
+    unsigned textures = 0, tluts = 0, arrays = 0;
+    for (u32 attr = 0; attr < 32u; ++attr) {
+        if (g_array_address[attr] == 0u)
+            continue;
+        u32 available = 0;
+        void* data = graphics_guest_pointer(cpu, g_array_address[attr],
+                                            &available);
+        if (data == NULL || available == 0u)
+            continue;
+        dol_platform_set_array_guest(attr, g_array_address[attr], data,
+                                     available, g_array_stride[attr]);
+        ++arrays;
+    }
+    for (u32 i = 0; i < GX_MAX_TEXTURES; ++i)
+        textures += g_textures[i].valid ? 1u : 0u;
+    for (u32 i = 0; i < GX_MAX_TLUTS; ++i)
+        tluts += g_tluts[i].valid ? 1u : 0u;
+    emit_gx_resource_metadata(cpu);
+    const char* force_dirty = getenv("BALLPAD_QUICKBOOT_FORCE_GX_DIRTY");
+    if (force_dirty != NULL && force_dirty[0] != '\0' &&
+        force_dirty[0] != '0') {
+        const u32 gx_data =
+            mem_read32(cpu, cpu->gpr[2] + (u32)(s32)GX_DATA_SDA_OFFSET);
+        if (gx_data >= GC_RAM_BASE) {
+            // Let the next normal GXBegin call the game's own dirty-state
+            // helper. This re-emits scalar GX registers/matrices in correct
+            // guest ordering; it is intentionally an opt-in QuickBoot probe.
+            mem_write32(cpu, gx_data + GX_DIRTY_STATE_OFFSET, 0x1Fu);
+            fprintf(stderr,
+                    "[quickboot-hle] forced guest GX dirty state @0x%08X\n",
+                    gx_data + GX_DIRTY_STATE_OFFSET);
+        } else {
+            fprintf(stderr,
+                    "[quickboot-hle] cannot force GX dirty; gx_data=0x%08X\n",
+                    gx_data);
+        }
+    }
+    fprintf(stderr,
+            "[quickboot-hle] restored textures=%u tluts=%u arrays=%u bytes=%u\n",
+            textures, tluts, arrays, (unsigned)sizeof *state);
+    return true;
+}
