diff --git a/runtime/host/interrupt.c b/runtime/host/interrupt.c
index 6efc385..4c0a234 100644
--- a/runtime/host/interrupt.c
+++ b/runtime/host/interrupt.c
@@ -16,6 +16,16 @@
 #define DISPATCH_INTERRUPT 0x80256FD0u  // __OSDispatchInterrupt(exc, context)
 #define EXC_EXTERNAL 4u                 // __OS_EXCEPTION_EXTERNAL_INTERRUPT
 
+// Decrementer (OSAlarm timer) support: the Gekko DEC (SPR 22) counts down at the
+// timebase rate and raises the 0x800-class exception on underflow. The OS alarm
+// queue and thread scheduler depend on it (OSSleep/OSWaitSemaphore timeouts,
+// loading screens), so without it the guest deadlocks in OSSelectThread whenever
+// every thread waits on a timer. We vector straight to the recompiled callback
+// with a pre-saved context, mirroring deliver_external() for the PI interrupts.
+#define SPR_DEC 22u
+#define DECREMENTER_CALLBACK 0x8025409Cu // DecrementerExceptionCallback(exc, ctx)
+#define EXC_DECREMENTER 8u               // __OS_EXCEPTION_DECREMENTER
+
 // OSContext field offsets (dolphin/os/OSContext.h).
 #define CTX_CR 0x080u
 #define CTX_LR 0x084u
@@ -51,6 +61,8 @@ static u64 frame_work_units;
 // interrupt_poll). Accumulator of guest blocks since the last batched pass.
 #define INTERRUPT_POLL_INTERVAL 128u
 static u32 interrupt_poll_accum;
+static bool s_dec_fired;
+unsigned long long g_dec_deliveries = 0;
 
 #define FPU_CONTEXT_CACHE_CAPACITY 32u
 typedef struct {
@@ -140,6 +152,7 @@ void interrupt_init(void) {
     dol_si_init(&si);
     dol_vi_clock_init(&vi_clock);
     interrupt_poll_accum = 0;
+    s_dec_fired = false;
     frame_work_units = DEFAULT_FRAME_BLOCKS;
     memset(fpu_context_cache, 0, sizeof fpu_context_cache);
     fpu_context_cache_next = 0;
@@ -156,6 +169,42 @@ void interrupt_init(void) {
     audio_set_vi_clock(frame_work_units, (u32)VI_REFRESH_HZ);
 }
 
+// Save the interrupted CPU state into the current OSContext and vector to the
+// recompiled DecrementerExceptionCallback. Same context layout as the asm
+// DecrementerExceptionHandler prologue (OS_EXCEPTION_SAVE_GPRS) that the host
+// normally skips, mirroring deliver_external().
+static void deliver_decrementer(CPUState* cpu) {
+    u32 ctx = mem_read32(cpu, OS_CURRENT_CONTEXT);
+    if (ctx < GC_RAM_BASE || ctx >= GC_RAM_BASE + cpu->ram_size)
+        return;  // no current context established yet
+
+    capture_fpu_context(cpu, ctx);
+    for (int i = 0; i < 32; i++)
+        mem_write32(cpu, ctx + (u32)i * 4u, cpu->gpr[i]);
+    mem_write32(cpu, ctx + CTX_CR, cpu->cr);
+    mem_write32(cpu, ctx + CTX_LR, cpu->lr);
+    mem_write32(cpu, ctx + CTX_CTR, cpu->ctr);
+    mem_write32(cpu, ctx + CTX_XER, cpu->xer);
+    for (int i = 0; i < 32; i++) {
+        u64 bits;
+        memcpy(&bits, &cpu->fpr[i], sizeof bits);
+        mem_write64(cpu, ctx + CTX_FPR + (u32)i * 8u, bits);
+    }
+    mem_write32(cpu, ctx + CTX_FPSCR, cpu->fpscr);
+    mem_write32(cpu, ctx + CTX_SRR0, cpu->pc);
+    mem_write32(cpu, ctx + CTX_SRR1, cpu->msr);
+    mem_write16(cpu, ctx + CTX_STATE, OS_CONTEXT_STATE_FPSAVED);
+    for (int i = 0; i < 8; i++)
+        mem_write32(cpu, ctx + CTX_GQR + (u32)i * 4u, cpu->gqr[i]);
+
+    cpu->gpr[3] = EXC_DECREMENTER;
+    cpu->gpr[4] = ctx;
+    cpu->srr0 = cpu->pc;
+    cpu->srr1 = cpu->msr;
+    cpu->msr &= ~MSR_EE;  // run the handler with external interrupts masked
+    cpu->pc = DECREMENTER_CALLBACK;
+}
+
 void interrupt_commit_pe_finish(void) {
     dol_interrupts_commit_pe_finish(&interrupts);
 }
@@ -238,7 +287,11 @@ static void deliver_external(CPUState* cpu) {
 // (INTERRUPT_POLL_INTERVAL + interrupt_poll_accum declared once above.)
 
 void interrupt_poll(CPUState* cpu) {
-    audio_poll(cpu);
+    // Skip the per-block audio DMA poll entirely when the host disabled
+    // audio output (iOS): the call overhead alone showed up in profiles even
+    // with an early return inside.
+    if (audio_enabled())
+        audio_poll(cpu);
 
     if (++interrupt_poll_accum < INTERRUPT_POLL_INTERVAL)
         return;
@@ -254,11 +307,35 @@ void interrupt_poll(CPUState* cpu) {
     u64 ticks = 0;
     while (dol_vi_clock_pop_retrace(&vi_clock, &ticks)) {
         cpu->timebase += ticks;
+        // The decrementer counts down in lockstep with the timebase. A write of
+        // zero disarms it (Gekko: DEC underflow fires only after a nonzero load).
+        const u32 dec = cpu->spr[SPR_DEC];
+        if (dec != 0u) {
+            if (dec > (u32)ticks)
+                cpu->spr[SPR_DEC] = dec - (u32)ticks;
+            else {
+                cpu->spr[SPR_DEC] = 0u;
+                s_dec_fired = true;
+            }
+        }
         dol_interrupts_assert_vi_retrace(&interrupts);
         dol_si_latch_poll(&si, 0xFu);
         sync_si_interrupt();
     }
 
+    // Deliver the DEC exception before PI externals so long alarm-timer waits
+    // (thread timeouts, loading screens) wake up even when no other source is
+    // pending. The DEC exception is EE-masked like external interrupts.
+    if (s_dec_fired && (cpu->msr & MSR_EE)) {
+        s_dec_fired = false;
+        g_dec_deliveries++;
+        if (getenv("BALLPAD_DEBUG_TIMER"))
+            fprintf(stderr, "[interrupt] DEC exception -> 0x8025409C tb=%llu dec=%u msr=0x%08X\n",
+                    (unsigned long long)cpu->timebase, cpu->spr[SPR_DEC], cpu->msr);
+        deliver_decrementer(cpu);
+        return;
+    }
+
     // Deliver only when the guest can take an external interrupt and at least one
     // pending source is unmasked in the PI. One delivery drains every pending,
     // unmasked source: __OSDispatchInterrupt loops over the PI cause bits.
