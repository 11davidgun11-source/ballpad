+void ballpad_diag_draw_model(CPUState* cpu, u32 object) {
+    if (getenv("STRIKERS_DRAW_MODEL_LOG") == NULL || object == 0u)
+        return;
+    const u32 creation = mem_read32(cpu, object + 0x78u);
+    const bool all_models = getenv("STRIKERS_DRAW_MODEL_ALL") != NULL;
+    if (!all_models && (creation & 0x100u) == 0u)
+        return;
+    const u32 flags = mem_read32(cpu, object + 0x8Cu);
+    unsigned view = 3u;
+    if (flags & 0x8u)
+        view = 0x16u;
+    else {
+        if (creation & 0x4u)
+            view = 7u;
+        if (creation & 0x100u)
+            view = 2u;
+        if (flags & 0x40u)
+            view = 0x13u;
+    }
+    static unsigned logged_models;
+    if (all_models && logged_models >= 2000u)
+        return;
+    ++logged_models;
+    const u32 task_manager = mem_read32(cpu, 0x803742B8u);
+    const u32 state = task_manager ? mem_read32(cpu, task_manager + 0x08u) : 0u;
+    fprintf(stderr,
+            "[draw-model] state=0x%08X object=0x%08X creation=0x%08X "
+            "flags=0x%08X view=%u model=0x%08X pos=(%.2f,%.2f,%.2f)\n",
+            state, object, creation, flags, view, mem_read32(cpu, object + 0x9Cu),
+            (double)guest_read_f32(cpu, object + 0x34u),
