diff --git a/CMakeLists.txt b/CMakeLists.txt
index 27b70fc..4371d9e 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -102,3 +102,44 @@ if(STRIKERSRECOMP_ENABLE_AURORA)
     target_compile_definitions(StrikersRecomp PRIVATE STRIKERSRECOMP_AURORA=1)
     set_target_properties(StrikersRecomp PROPERTIES LINKER_LANGUAGE CXX)
 endif()
+
+
+# --- Ballpad bridge: DolRecomp FP helper ABI for older GXRuntime ---
+set(BALLPAD_HOST_DIR "${CMAKE_SOURCE_DIR}/../../host" CACHE PATH "Ballpad host bridge")
+if(EXISTS "${BALLPAD_HOST_DIR}/src/ballpad_ppc_helpers.c")
+    target_sources(StrikersRecomp PRIVATE "${BALLPAD_HOST_DIR}/src/ballpad_ppc_helpers.c")
+    target_include_directories(StrikersRecomp PRIVATE "${BALLPAD_HOST_DIR}/include")
+    target_compile_options(StrikersRecomp PRIVATE
+        "-include${BALLPAD_HOST_DIR}/include/ballpad_ppc_helpers_inject.h")
+    message(STATUS "Ballpad: linking ppc helper bridge from ${BALLPAD_HOST_DIR}")
+endif()
+
+# --- Ballpad: static host library for the iOS app (no main) ---
+option(BALLPAD_BUILD_STATIC_HOST "Build libBallpadHost.a (iOS app linking)" OFF)
+if(BALLPAD_BUILD_STATIC_HOST)
+  add_library(BallpadHost STATIC
+      runtime/host/mmio.c
+      runtime/host/audio.c
+      runtime/host/interrupt.c
+      runtime/host/hle.c
+      runtime/host/sdk_map.c
+      "${STRIKERSRECOMP_GENERATED_DIR}/generated.c"
+      ${STRIKERSRECOMP_CHUNKS}
+      "${BALLPAD_HOST_DIR}/src/ballpad_ppc_helpers.c"
+  )
+  target_include_directories(BallpadHost PRIVATE
+      "${CMAKE_SOURCE_DIR}/runtime"
+      "${STRIKERSRECOMP_GENERATED_DIR}"
+      "${BALLPAD_HOST_DIR}/include"
+  )
+  if(EXISTS "${BALLPAD_HOST_DIR}/include/ballpad_ppc_helpers_inject.h")
+    target_compile_options(BallpadHost PRIVATE
+        "-include${BALLPAD_HOST_DIR}/include/ballpad_ppc_helpers_inject.h")
+  endif()
+  target_link_libraries(BallpadHost PRIVATE GXRuntime::runtime)
+  if(STRIKERSRECOMP_ENABLE_AURORA)
+    target_link_libraries(BallpadHost PRIVATE GXRuntime::aurora)
+    target_compile_definitions(BallpadHost PRIVATE STRIKERSRECOMP_AURORA=1)
+  endif()
+  set_target_properties(BallpadHost PROPERTIES LINKER_LANGUAGE CXX)
+endif()
