+enum {
+    HLE_SCENE_MARKER_HUD_CREATED = 1u << 0,
+    HLE_SCENE_MARKER_MATCH_ZERO = 1u << 1,
+};
+
+static HleSceneSnapshot g_scene_snapshot = {
+    0u, -2, -2, 0u, 0u, -1,
+};
+static bool g_scene_trace_initialized = false;
+static bool g_scene_trace = false;
+
+static void scene_trace_init(void) {
+    if (!g_scene_trace_initialized) {
+        g_scene_trace_initialized = true;
+        g_scene_trace = getenv("BALLPAD_SCENE_TRACE") != NULL;
+    }
+}
+
+static int32_t scene_current(CPUState* cpu) {
+    const u32 manager = mem_read32(cpu, GAME_OBJ_SCENE_MANAGER_POINTER);
+    const u32 depth = manager != 0u ? mem_read32(cpu, manager + 4u) : 0u;
+    if (manager == 0u || depth == 0u || depth > 32u)
+        return -2;
+    return (int32_t)mem_read32(cpu, manager + 8u + (depth - 1u) * 4u);
+}
+
+static int32_t scene_game_state(CPUState* cpu) {
+    const u32 game = mem_read32(cpu, GAME_OBJ_GAME_POINTER);
+    return game != 0u ? (int32_t)mem_read32(cpu, game + 0x24u) : -1;
+}
+
+static void scene_emit(CPUState* cpu, const char* event, const char* function,
+                       int32_t requested) {
+    scene_trace_init();
+    g_scene_snapshot.event_sequence++;
+    g_scene_snapshot.requested_scene = requested;
+    g_scene_snapshot.current_scene = scene_current(cpu);
+    g_scene_snapshot.game_state = scene_game_state(cpu);
+    if (g_scene_trace)
+        fprintf(stderr, "[scene] seq=%llu event=%s scene=%d function=%s "
+                        "rel_frame=%llu game_state=%d\n",
+                (unsigned long long)g_scene_snapshot.event_sequence, event,
+                g_scene_snapshot.current_scene, function,
+                (unsigned long long)g_scene_snapshot.relative_fixed_updates,
+                g_scene_snapshot.game_state);
+}
+
+static void notify_scene_push(CPUState* cpu) {
+    scene_emit(cpu, "push", "Push__20BaseGameSceneManagerF9SceneList14ScreenMovementb",
+               (int32_t)cpu->gpr[4]);
+}
+
+static void notify_scene_pop(CPUState* cpu) {
+    scene_emit(cpu, "pop", "Pop__20BaseGameSceneManagerFv", -2);
+}
+
+static void notify_scene_push_loading(CPUState* cpu) {
+    scene_emit(cpu, "push-loading", "PushLoadingScene__20BaseGameSceneManagerFb", 43);
+}
+
+static void notify_scene_hud_created(CPUState* cpu) {
+    g_scene_snapshot.marker_flags |= HLE_SCENE_MARKER_HUD_CREATED |
+                                     HLE_SCENE_MARKER_MATCH_ZERO;
+    g_scene_snapshot.relative_fixed_updates = 0u;
+    scene_emit(cpu, "match-zero", "SceneCreated__10HUDOverlayFv", 67);
+}
+
+static void notify_scene_fixed_update(CPUState* cpu) {
+    g_scene_snapshot.relative_fixed_updates++;
+    if ((g_scene_snapshot.marker_flags & HLE_SCENE_MARKER_MATCH_ZERO) == 0u) {
+        g_scene_snapshot.current_scene = scene_current(cpu);
+        g_scene_snapshot.game_state = scene_game_state(cpu);
+        return;
+    }
+    const u64 frame = g_scene_snapshot.relative_fixed_updates;
+    if (frame == 1u || frame == 60u || frame == 300u || frame == 600u) {
+        scene_emit(cpu, "fixed-update", "Run__15FixedUpdateTaskFf", -2);
+    } else {
+        g_scene_snapshot.current_scene = scene_current(cpu);
+        g_scene_snapshot.game_state = scene_game_state(cpu);
+    }
+}
+
+bool hle_scene_snapshot(HleSceneSnapshot* out) {
+    if (out == NULL)
+        return false;
+    *out = g_scene_snapshot;
+    return true;
+}
