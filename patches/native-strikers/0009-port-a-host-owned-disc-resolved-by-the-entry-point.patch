From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chris Sotraidis <56282582+chrissotraidis@users.noreply.github.com>
Date: Mon, 14 Sep 2026 23:42:02 -0500
Subject: [PATCH] port: a host-owned disc, resolved by the entry point

DVDInit runs from a static initialiser (nlMalloc -> nlInitMemory), which on a
mobile host is before that host's framework exists.  That was fine while the
disc could only come from the environment, a directory beside the executable,
the working directory or a source checkout -- none of which a sandboxed host
can write -- but it made "the player supplies their own disc through the app"
impossible to order: the port resolves, and gives up, before the app that
would import one has a framework.

So a disc the port cannot use is now recorded and returned from instead of
being fatal: gamedata.h publishes whether a disc resolved, the title and text
the box would have carried, and a re-resolve.  The entry point -- main.cpp's
main, which on iOS runs from the scene delegate, after UIKit and before any
game code reads the disc -- asks the host to import and resolves again.  Two
more hostui.h hooks are the host's side of it, both weak no-ops by default:
GameDataPath, which joins the port's own search (called from the static
initialiser, so it must not touch a UI framework), and RunGameDataImport,
which is handed the finished text the port would have shown.

A second resolution is only honest if nothing from the first one survives it,
which is the part that is easy to get wrong: the entry table is freed, the
open image is closed, and the disc id, region and game/maker code caches are
cleared, because those are answers about the disc that was refused.  A
desktop build defines none of the host hooks, so RunGameDataImport returns 0
and the port reaches the same box, with the same text, that it always did --
verified on the three desktop paths: no data exits 1 with the unchanged
message, a valid image runs and exits 0, a bad backend name exits 1.

// PORT: data path only; the game itself is untouched.
---
 smstrikers-port/include/port/gamedata.h |  34 ++++
 smstrikers-port/include/port/hostui.h   |  27 +++
 smstrikers-port/src/Game/main.cpp       |  25 +++
 smstrikers-port/src/platform/dvd.c      | 209 +++++++++++++++++++-----
 smstrikers-port/src/platform/hostui.c   |  15 ++
 5 files changed, 271 insertions(+), 39 deletions(-)
 create mode 100644 smstrikers-port/include/port/gamedata.h

diff --git a/smstrikers-port/include/port/gamedata.h b/smstrikers-port/include/port/gamedata.h
new file mode 100644
index 0000000..bdca20b
--- /dev/null
+++ b/smstrikers-port/include/port/gamedata.h
@@ -0,0 +1,34 @@
+// Whether the port found a disc it can play, and, when it did not, the box it would have shown.
+//
+// The port resolves its disc from a static initialiser (nlMalloc -> nlInitMemory -> DVDInit), which
+// on a mobile host runs before that host application's own framework exists. Exiting there would
+// take a host that has an importer down with it, so a disc the port cannot use is recorded instead
+// and the entry point decides what to do about it. See include/port/hostui.h for the two hooks a
+// host uses to answer.
+
+#ifndef PORT_GAMEDATA_H
+#define PORT_GAMEDATA_H
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+// Nonzero once a disc image or an extracted filesystem has been found, indexed, and identified as
+// this game's disc. False after a refusal, even when files were found.
+int PortGameDataReady(void);
+
+// What the port would have shown. Both are never NULL, and both are empty until the first
+// resolution has run.
+const char* PortGameDataErrorTitle(void);
+const char* PortGameDataErrorMessage(void);
+
+// Resolve again, from the state the first attempt started from: called by the port's entry point
+// after a host has staged the player's own disc, so that the entry point needs no knowledge of the
+// DVD layer it is re-running. A no-op when the first attempt already found usable data.
+void PortGameDataResolve(void);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif // PORT_GAMEDATA_H
diff --git a/smstrikers-port/include/port/hostui.h b/smstrikers-port/include/port/hostui.h
index 694dab3..0884ddb 100644
--- a/smstrikers-port/include/port/hostui.h
+++ b/smstrikers-port/include/port/hostui.h
@@ -78,6 +78,33 @@ void PortHostUIFrame(void);
 
 void PortHostUIStop(void);
 
+// Game data: the disc the port is going to play, for a host that has to import it.
+//
+// The port resolves its disc before the host's own framework exists -- from a static initialiser,
+// ahead of main() -- and looks only in the environment, the directory beside the executable and the
+// working directory. A sandboxed host application can write to none of those. These two hooks are
+// how a host's own store joins that search, and they are the pair that makes an import survive a
+// cold start rather than only the run that performed it.
+//
+// Order the port guarantees:
+//   PortHostUIGameDataPath      from the port's disc search, which is a static initialiser. The
+//                               host must not touch a UI framework from here.
+//   PortHostUIRunGameDataImport from the port's entry point, after a search that found nothing
+//                               usable and before any game code reads the disc. On iOS this is
+//                               inside the host's application delegate, so UIKit is up.
+
+// The host's location for the disc, or NULL when it has staged nothing. A disc image or an
+// extracted `files` directory, in any format port_disc_open accepts (include/port/disc.h). The
+// port copies it, so the returned pointer need not outlive the call.
+const char* PortHostUIGameDataPath(void);
+
+// The port's fatal `game data` / `unusable disc` refusal, handed to a host that would rather show
+// its own importer. `message` is the finished, user-facing explanation the port would have put in
+// the box, including its own wording for a refusal made after finding files. Returns nonzero if the
+// host staged data and the port should resolve again, zero to let the port report the failure the way
+// it always has.
+int PortHostUIRunGameDataImport(const char* title, const char* message);
+
 #ifdef __cplusplus
 }
 #endif
diff --git a/smstrikers-port/src/Game/main.cpp b/smstrikers-port/src/Game/main.cpp
index c3f3c3f..e6d988e 100644
--- a/smstrikers-port/src/Game/main.cpp
+++ b/smstrikers-port/src/Game/main.cpp
@@ -27,6 +27,9 @@ extern "C" void PortDebugFrame(void);   // PORT: defined in Game.cpp
 #include <TargetConditionals.h>  // PORT: TARGET_OS_IPHONE, for the same
 #endif
 #endif
+#include "port/fatal.h"     // PORT: the box an unresolved disc still gets on a host with no importer
+#include "port/gamedata.h"  // PORT: whether the disc resolved, and the box it would have shown
+#include "port/hostui.h"    // PORT: the host's own importer, when it has one
 #include "port/benchmark.h"
 #include "port/audio.h"
 #include "port/determinism.h"
@@ -682,6 +685,28 @@ static void PortPumpAuroraEvents()
 
 int main(int argc, char* argv[])
 {
+    // PORT: the disc. The port resolves it from a static initialiser (nlInitMemory -> DVDInit),
+    // which on a mobile host runs before that host's framework exists, so a disc it could not use
+    // was recorded rather than made fatal (include/port/gamedata.h). This is the first point in the
+    // run that is both after the framework and before any game code reads the disc, so it is where
+    // a host that takes the player's own disc in itself is given its chance: import, then resolve
+    // again from the state the first attempt started from. A host with no importer -- every desktop
+    // build -- falls straight through to the same box, with the same text, it always had.
+    if (!PortGameDataReady())
+    {
+        const char* title = PortGameDataErrorTitle();
+        const char* message = PortGameDataErrorMessage();
+        if (title[0] == '\0')
+            title = "Super Mario Strikers: game data not found";
+        if (message[0] == '\0')
+            message = "The game data was not found, and the disc has not been resolved yet.";
+
+        if (PortHostUIRunGameDataImport(title, message) != 0)
+            PortGameDataResolve();
+        if (!PortGameDataReady())
+            port_fatal(title, message);
+    }
+
     // PORT: strikers.ini -> environment, before anything reads one.
     {
         const int applied = PortConfigLoad();
diff --git a/smstrikers-port/src/platform/dvd.c b/smstrikers-port/src/platform/dvd.c
index e1c265d..9f8b90c 100644
--- a/smstrikers-port/src/platform/dvd.c
+++ b/smstrikers-port/src/platform/dvd.c
@@ -10,8 +10,9 @@
 #include "dolphin/types.h"
