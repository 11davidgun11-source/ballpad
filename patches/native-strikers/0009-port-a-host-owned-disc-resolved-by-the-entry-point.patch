-    static char code[3];
-    if (code[0] == 0)
+    if (s_maker_code[0] == 0)
     {
-        memcpy(code, disk_id_bytes() + 4, 2);
-        code[2] = '\0';
+        memcpy(s_maker_code, disk_id_bytes() + 4, 2);
+        s_maker_code[2] = '\0';
