+++ b/smstrikers-port/src/Game/main.cpp
@@ -14,6 +14,9 @@
 #include <SDL3/SDL_video.h>
 #endif
 #include "port/overlay.h"
+// PORT: the host application's own interface above the game (mobile touch controls). Weak no-ops
+// unless the host defines them; see include/port/hostui.h for the guarantee about when they run.
+#include "port/hostui.h"
 extern "C" void PortDebugFrame(void);   // PORT: defined in Game.cpp
 #include "port/launch.h"
 #include <aurora/main.h>   // #define main aurora_main
@@ -771,6 +774,10 @@ int main(int argc, char* argv[])
             s_portWindow = info.window;
         }
 
+        // PORT: after the window and its aspect exist and before the first frame, which is the only
+        // moment a host interface can be placed above a renderer that is not yet presenting.
+        PortHostUIStart(info.window);
+
         // PORT: Aurora falls back to its preference order when the requested backend will not start.
         if (wantBackend != BACKEND_AUTO && info.backend != wantBackend)
         {
@@ -837,6 +844,9 @@ int main(int argc, char* argv[])
     {
         PortPumpAuroraEvents();
         PortUpdateSyntheticInput(s_portFrame);
+        // PORT: after the port has assembled this frame's pad, before the tasks read it, so a host
+        // interface's touch state and a synthetic press merge in the same place instead of racing.
+        PortHostUIFrame();
         PortDebugFrame();
 
         if (!aurora_begin_frame())
@@ -895,6 +905,9 @@ int main(int argc, char* argv[])
         }
     }
     PortBenchReport();
+    // PORT: the loop is over, so a host interface must stop publishing input before the surface it
+    // is drawing over goes away.
+    PortHostUIStop();
     aurora_shutdown();
     // PORT: on iOS this main() is not the process entry point. UIKit calls it from the scene
     // delegate's postFinishLaunch, so returning from it leaves the application alive with no
diff --git a/smstrikers-port/src/platform/hostui.c b/smstrikers-port/src/platform/hostui.c
new file mode 100644
index 0000000..cda21e7
--- /dev/null
+++ b/smstrikers-port/src/platform/hostui.c
@@ -0,0 +1,44 @@
+// The default host interface: four no-ops.
+//
+// A host application that draws its own controls over the game defines these instead, and a strong
+// definition beats a weak one. Keeping the defaults here rather than behind an #ifdef means an
+// ordinary desktop build links the same object list as a mobile one, so the absence of a host
+// interface is a property of the host and never of the platform.
+
+#include "port/hostui.h"
+
+// These must lose to a host's own definitions; a strong symbol beats a weak one, and
+// `weak_definition` on Mach-O and `weak` on ELF are the same declaration in clang.
+//
+// Losing is automatic only when the host's definitions are themselves on the link line. A weak
+// definition in this object file already satisfies every reference, so the linker has no reason to
+// search an archive for these symbols and a host that packages its side as a static library is
+// never reached -- the build links, runs, and quietly has no host interface. A host packaging them
+// that way must pull its archive in unconditionally; Ballpad's iOS app pairs a whole-archive pull
+// with an explicit -Wl,-u for each hook.
+#if defined(__GNUC__)
+#define PORT_WEAK __attribute__((weak))
+#else
+#define PORT_WEAK
+#endif
+
+PORT_WEAK void PortHostUIStart(void* sdlWindow)
+{
+    (void)sdlWindow;
+}
+
+PORT_WEAK void PortHostUIFrame(void)
+{
+}
+
+PORT_WEAK void PortHostUIStop(void)
+{
+}
+
+// "No host pad" is the whole answer on a platform with no host interface: the port's own synthetic
+// input is then the only source, exactly as it was before this seam existed.
+PORT_WEAK int PortHostUIPollPad(PortHostPad* out)
+{
+    (void)out;
+    return 0;
+}
diff --git a/smstrikers-port/src/platform/input.cpp b/smstrikers-port/src/platform/input.cpp
index b49517a..4237a8f 100644
--- a/smstrikers-port/src/platform/input.cpp
+++ b/smstrikers-port/src/platform/input.cpp
@@ -21,8 +21,26 @@ extern "C" void PortUpdateSyntheticInput(unsigned long frame) { (void)frame; }
 
 #include "dolphin/os.h"
 #include "dolphin/pad.h"
+#include "port/hostui.h"
 #include "port/input.h"
 
+// The pad bits in port/hostui.h are a second spelling of the engine's, so that a host can
+// translate its own layout without including a Dolphin header. These assertions are what keep that
+// spelling honest: if Aurora's pad bits move, this file stops compiling instead of an app silently
+// pressing the wrong button.
+static_assert(PORT_PAD_BUTTON_LEFT == PAD_BUTTON_LEFT, "port host pad: left");
+static_assert(PORT_PAD_BUTTON_RIGHT == PAD_BUTTON_RIGHT, "port host pad: right");
+static_assert(PORT_PAD_BUTTON_DOWN == PAD_BUTTON_DOWN, "port host pad: down");
+static_assert(PORT_PAD_BUTTON_UP == PAD_BUTTON_UP, "port host pad: up");
+static_assert(PORT_PAD_TRIGGER_Z == PAD_TRIGGER_Z, "port host pad: z");
+static_assert(PORT_PAD_TRIGGER_R == PAD_TRIGGER_R, "port host pad: r");
+static_assert(PORT_PAD_TRIGGER_L == PAD_TRIGGER_L, "port host pad: l");
+static_assert(PORT_PAD_BUTTON_A == PAD_BUTTON_A, "port host pad: a");
+static_assert(PORT_PAD_BUTTON_B == PAD_BUTTON_B, "port host pad: b");
+static_assert(PORT_PAD_BUTTON_X == PAD_BUTTON_X, "port host pad: x");
+static_assert(PORT_PAD_BUTTON_Y == PAD_BUTTON_Y, "port host pad: y");
+static_assert(PORT_PAD_BUTTON_START == PAD_BUTTON_START, "port host pad: start");
+
 namespace
 {
 
@@ -966,12 +984,30 @@ void record_pad(unsigned long frame)
     s_haveLastRecorded = true;
 }
 
+// Aurora's own rule for combining a virtual pad with a physical one (merge_virtual_status in
+// extern/aurora/lib/dolphin/pad/pad.cpp): the axis with the larger magnitude wins. Using the same
+// rule here keeps a host's touch stick and the port's synthetic stick from cancelling each other
+// out and centring the stick while both are pushed.
+int dominant_axis(int a, int b)
+{
+    return std::abs(b) > std::abs(a) ? b : a;
+}
+
 }   // namespace
 
 extern "C" void PortUpdateSyntheticInput(unsigned long frame)
 {
     s_currentFrame = frame;
 
+    // The host application's own interface is polled here, once per frame, at the top of the frame
+    // in which its input is used. Two consequences are deliberate: the host's pad joins the
+    // synthetic pad below instead of replacing it, and the poll happens even when a recording is
+    // about to take over, because a source whose edges are cleared on read would otherwise carry a
+    // press into a later frame. A recording is still a complete description of the input, so its
+    // result is read and then deliberately dropped.
+    PortHostPad hostPad;
+    const bool haveHostPad = PortHostUIPollPad(&hostPad) != 0;
+
     // A controller can arrive at any time, and its mapping is Aurora's until the file's is put over
     // it.
     poll_controllers(probe_pad());
@@ -1019,6 +1055,23 @@ extern "C" void PortUpdateSyntheticInput(unsigned long frame)
     }
     held |= fake_key_state(frame, &lx, &ly, &rx, &ry, &tl, &tr);
 
+    // The host's contribution, merged with Aurora's own virtual-pad rules rather than assigned
+    // over the top of them: buttons are OR'ed, the stronger axis reading wins, a trigger keeps the
+    // larger pressure. The clamps below then hold whatever the two of them produced to the pad's
+    // range.
+    if (haveHostPad)
+    {
+        held |= (PADButton)hostPad.buttons;
+        lx = dominant_axis(lx, hostPad.stickX);
+        ly = dominant_axis(ly, hostPad.stickY);
+        rx = dominant_axis(rx, hostPad.substickX);
+        ry = dominant_axis(ry, hostPad.substickY);
+        if (hostPad.triggerLeft > tl)
+            tl = hostPad.triggerLeft;
+        if (hostPad.triggerRight > tr)
+            tr = hostPad.triggerRight;
+    }
+
     if (held == 0 && lx == 0 && ly == 0 && rx == 0 && ry == 0 && tl == 0 && tr == 0)
     {
         PADClearVirtualStatus(0);
