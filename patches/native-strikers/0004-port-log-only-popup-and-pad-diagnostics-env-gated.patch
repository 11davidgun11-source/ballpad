From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chris Sotraidis <56282582+chrissotraidis@users.noreply.github.com>
Date: Mon, 14 Sep 2026 20:01:32 -0500
Subject: [PATCH] port: log-only popup and pad diagnostics, env gated

Two diagnostics that made the front end measurable instead of guessed at,
both gated behind their own variable and neither changing behaviour:

  STRIKERS_LOG_POPUP  the popup's own input gate -- created, displayed,
                      accept delay, option count, slide timing and the live A
                      edge -- once per frame, so a press the popup ignores can
                      be told apart from one the pad never delivered.
  STRIKERS_LOG_INPUT  the pad's category, error and just-pressed/released
                      edges after every resample, the other half of that
                      comparison. Both anchor their lines to the port frame
                      counter.
---
 smstrikers-port/src/Game/FE/fePopupMenu.cpp | 27 +++++++++++++++++++++
 smstrikers-port/src/NL/plat/platpad.cpp     | 22 +++++++++++++++++
 2 files changed, 49 insertions(+)

diff --git a/smstrikers-port/src/Game/FE/fePopupMenu.cpp b/smstrikers-port/src/Game/FE/fePopupMenu.cpp
index 01a02bd..caadc35 100644
--- a/smstrikers-port/src/Game/FE/fePopupMenu.cpp
+++ b/smstrikers-port/src/Game/FE/fePopupMenu.cpp
@@ -21,6 +21,18 @@
 #include "Game/SH/SHOptions.h"
 #include "NL/nlString.h"
 
+#include "port/input.h"   // PORT: STRIKERS_LOG_POPUP anchors its lines to the port frame counter
+#include <stdlib.h>
+
+// PORT: STRIKERS_LOG_POPUP dumps the popup's input gate once per frame. It is a diagnostic only --
+// nothing here changes what the popup does -- so a press the popup ignores can be told apart from
+// one the pad never delivered.
+static bool log_popup_enabled()
+{
+    static const int s_enabled = (getenv("STRIKERS_LOG_POPUP") != NULL) ? 1 : 0;
+    return s_enabled == 1;
+}
+
 char* optionNames[4] = { "Option1", "Option2", "Option3", "Option4" };
 
 // PORT: a runtime value now.
@@ -266,6 +278,21 @@ void FEPopupMenu::SceneCreated()
  */
 void FEPopupMenu::Update(float fDeltaT)
 {
+    if (log_popup_enabled())
+    {
+        const TLSlide* pSlide = (m_pFEPresentation != NULL) ? m_pFEPresentation->m_currentSlide : NULL;
+        OSReport("[popup] f=%lu created=%d disp=%d a1f=%d aa4=%d acc=%.3f opts=%d hi=%d t=%.3f s=%.3f d=%.3f ctrl=%d lock=%d allow=%d jpA=%d isA=%d\n",
+                 PortInputFrame(), (int)mMenuCreated, (int)mMenuDisplayed, (int)mUnknownA1F,
+                 (int)mUnknownAA4, (double)mAcceptDelayTime, mPopup.numOptions, mHighlightedOption,
+                 pSlide != NULL ? (double)pSlide->m_time : -1.0,
+                 pSlide != NULL ? (double)pSlide->m_start : -1.0,
+                 pSlide != NULL ? (double)pSlide->m_duration : -1.0, (int)mControlInput,
+                 g_pFEInput != NULL ? g_pFEInput->m_InputLockDepth : -1,
+                 g_pFEInput != NULL ? (int)g_pFEInput->m_bInputAllowed : -1,
+                 g_pFEInput != NULL ? (int)g_pFEInput->JustPressed(mControlInput, 0x100, false, NULL) : -1,
+                 g_pFEInput != NULL ? (int)g_pFEInput->IsPressed(mControlInput, 0x100, false, NULL) : -1);
+    }
+
     if (!mMenuCreated)
     {
         return;
diff --git a/smstrikers-port/src/NL/plat/platpad.cpp b/smstrikers-port/src/NL/plat/platpad.cpp
index b985f24..ce25dbb 100644
--- a/smstrikers-port/src/NL/plat/platpad.cpp
+++ b/smstrikers-port/src/NL/plat/platpad.cpp
@@ -1,5 +1,6 @@
 #include "NL/platpad.h"
 #include "port/overlay.h"
+#include "port/input.h"   // PORT: STRIKERS_LOG_INPUT anchors its lines to the port frame counter
 #include <stdlib.h>
 #include "dolphin/os.h"
 
@@ -39,6 +40,15 @@ static inline void UpdateButtonStateTime(PadStatus* pPadStatus, int padIdx, floa
         button <<= 1;
     }
 }
+
+// PORT: STRIKERS_LOG_INPUT prints the pad's edge state after every resample. Like STRIKERS_LOG_POPUP
+// it is diagnostic only; it exists so a press the front end ignores can be told apart from one the
+// port never turned into a just-pressed edge.
+static bool log_input_enabled()
+{
+    static const int s_enabled = (getenv("STRIKERS_LOG_INPUT") != NULL) ? 1 : 0;
+    return s_enabled == 1;
+}
 } // namespace
 
 /**
@@ -403,6 +413,18 @@ void PadStatus::Update(float dt)
         }
     }
 
+    if (log_input_enabled())
+    {
+        OSReport("[pad] f=%lu cat=%d err=%d,%d,%d,%d cur=0x%04x,0x%04x,0x%04x,0x%04x prev0=0x%04x jp0=0x%04x jr0=0x%04x\n",
+                 PortInputFrame(), padStatus == &padCategories[1] ? 1 : 0,
+                 (int)PadStatus::s_Current[0].err, (int)PadStatus::s_Current[1].err,
+                 (int)PadStatus::s_Current[2].err, (int)PadStatus::s_Current[3].err,
+                 (unsigned)PadStatus::s_Current[0].button, (unsigned)PadStatus::s_Current[1].button,
+                 (unsigned)PadStatus::s_Current[2].button, (unsigned)PadStatus::s_Current[3].button,
+                 (unsigned)m_previousButtons[0], (unsigned)m_justPressed[0],
+                 (unsigned)m_justReleased[0]);
+    }
+
     if (resetMask)
     {
         PADReset(resetMask);
