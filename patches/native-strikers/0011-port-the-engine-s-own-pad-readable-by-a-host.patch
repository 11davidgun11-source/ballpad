From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chris Sotraidis <56282582+chrissotraidis@users.noreply.github.com>
Date: Tue, 15 Sep 2026 07:11:18 -0500
Subject: [PATCH] port: the engine's own pad, readable by a host

A host could publish a pad but not ask what the engine did with it, so
"my overlay drew the control" and "the game read it" were the same
reading from outside. PortPadEngineRead returns the bytes of
PadStatus::s_Current[port], which is the sample cPlatPad::IsPressed and
the game's own tasks read after VBlankPadUpdate has merged every source
into it.

The bits are spelled the same way a host publishes them, so a caller can
compare an offer and a reading without a translation table. It reports
the pad as it stands rather than inventing a neutral one, so an empty
port reads back as a nonzero err.

Caveat, stated in the header rather than left to a reader: IsPressed and
GetPressure read s_Current, but the just-pressed and just-released edges
read padStatus[0].m_justPressed, which is category-dependent. This
accessor does not cover the edge readings.
---
 smstrikers-port/include/port/input.h    | 24 +++++++++++++++++
 smstrikers-port/src/NL/plat/platpad.cpp | 36 +++++++++++++++++++++++++
 2 files changed, 60 insertions(+)

diff --git a/smstrikers-port/include/port/input.h b/smstrikers-port/include/port/input.h
index d525cd1..ebf9dd4 100644
--- a/smstrikers-port/include/port/input.h
+++ b/smstrikers-port/include/port/input.h
@@ -53,6 +53,30 @@ const char* PortPadName(unsigned int port);
 // same lifetime rule as the rows above.
 const char* PortPadDetail(unsigned int port);
 
+// What the engine's own pad holds for a port: PadStatus::s_Current[port], the sample the game's
+// tasks read through cPlatPad (cPlatPad::IsPressed and friends), after VBlankPadUpdate has merged
+// every source into it. A host's offer (PortHostUIPollPad, port/hostui.h) is a request; this is the
+// answer, one pad-assembly boundary later. The two are different claims, and only the second one
+// says the game read a control rather than that an overlay drew one.
+//
+// The bits are the same spelling a host publishes, so a caller can compare an offer and a reading
+// without a translation table: PAD_BUTTON_LEFT 0x0001 .. PAD_BUTTON_START 0x1000, PAD_TRIGGER_Z
+// 0x0010, PAD_TRIGGER_R 0x0020, PAD_TRIGGER_L 0x0040. The sticks are -128..127 with -128 as the
+// pad's own "nothing here" reading, and the triggers are 0..255.
+typedef struct PortPadEngineState
+{
+    int          err;           // PAD_ERR_*; cPlatPad::IsConnected reads 0 and -3 as connected
+    unsigned int buttons;
+    int          stickX, stickY;
+    int          substickX, substickY;
+    int          triggerLeft, triggerRight;
+} PortPadEngineState;
+
+// Returns 1 and fills *out for ports 0..3, and 0 for any other port or a NULL out, leaving *out
+// zeroed. It reports the pad as it stands rather than a fabricated neutral, so an empty port reads
+// back as a nonzero err.
+int PortPadEngineRead(unsigned int port, PortPadEngineState* out);
+
 #ifdef __cplusplus
 }
 #endif
diff --git a/smstrikers-port/src/NL/plat/platpad.cpp b/smstrikers-port/src/NL/plat/platpad.cpp
index ce25dbb..b6ebdd0 100644
--- a/smstrikers-port/src/NL/plat/platpad.cpp
+++ b/smstrikers-port/src/NL/plat/platpad.cpp
@@ -488,3 +488,39 @@ void UseFixedUpdatePad()
 {
     padStatus = &padCategories[1];
 }
+
+// PORT: what the engine's own pad holds, for a host that has to tell "my overlay drew the control"
+// apart from "the game read it". PadStatus::s_Current is the sample cPlatPad::IsPressed and the rest
+// of cPlatPad read, and VBlankPadUpdate swaps it in once a frame after PADRead has merged a host's
+// offer, the port's synthetic pad and any recording into it -- so this is the same bytes the game's
+// tasks act on, not a second opinion about them.
+extern "C" int PortPadEngineRead(unsigned int port, PortPadEngineState* out)
+{
+    if (out == NULL)
+        return 0;
+
+    // Written out rather than zeroed with memset: this struct is the whole of the answer, and a
+    // field skipped here is a field a host reads as a stale value.
+    out->err = 0;
+    out->buttons = 0;
+    out->stickX = 0;
+    out->stickY = 0;
+    out->substickX = 0;
+    out->substickY = 0;
+    out->triggerLeft = 0;
+    out->triggerRight = 0;
+
+    if (port >= 4)
+        return 0;
+
+    const PADStatus& pad = PadStatus::s_Current[port];
+    out->err = (int)pad.err;
+    out->buttons = (unsigned int)pad.button;
+    out->stickX = (int)pad.stickX;
+    out->stickY = (int)pad.stickY;
+    out->substickX = (int)pad.substickX;
+    out->substickY = (int)pad.substickY;
+    out->triggerLeft = (int)pad.triggerLeft;
+    out->triggerRight = (int)pad.triggerRight;
+    return 1;
+}
