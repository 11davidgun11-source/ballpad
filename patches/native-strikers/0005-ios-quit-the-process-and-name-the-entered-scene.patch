From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chris Sotraidis <56282582+chrissotraidis@users.noreply.github.com>
Date: Mon, 14 Sep 2026 20:01:43 -0500
Subject: [PATCH] ios: quit the process and name the entered scene

Both are iOS-only behaviours a driven run depends on.

main() is not the process entry point on iOS: UIKit calls it from the scene
delegate's postFinishLaunch, so returning from it leaves the application alive
with a shut-down engine behind it -- a frozen window over a destroyed GPU
device rather than a quit. The engine has already been shut down by then, so
the quit path ends the process. Other platforms still return from main.

The front-end scene manager reported only the scene number and told the driver
before the package name was resolved. It now formats the number and package
name together, reports them when STRIKERS_LOG_SCENES is set and hands the same
label to the debug menu, then notifies the driver -- so a scripted press has a
screen name to anchor to, including on the health and title screens that are
over before the first ten-second heartbeat could name them.
---
 .../src/Game/FE/BaseGameSceneManager.cpp      | 19 +++++++++++--------
 smstrikers-port/src/Game/main.cpp             | 12 ++++++++++++
 2 files changed, 23 insertions(+), 8 deletions(-)

diff --git a/smstrikers-port/src/Game/FE/BaseGameSceneManager.cpp b/smstrikers-port/src/Game/FE/BaseGameSceneManager.cpp
index 338bfe7..686015c 100644
--- a/smstrikers-port/src/Game/FE/BaseGameSceneManager.cpp
+++ b/smstrikers-port/src/Game/FE/BaseGameSceneManager.cpp
@@ -184,22 +184,25 @@ BaseSceneHandler* BaseGameSceneManager::Push(SceneList newscene, ScreenMovement
         newscene = SCENE_MARIO_BACKGROUND;
     }
 
-    // PORT: progress marker, see the note on.
-    if (getenv("STRIKERS_LOG_SCENES") != NULL)
-        OSReport("[port] enter scene %d\n", (int)newscene);
-
-    // PORT: and tell the synthetic-input driver, so a scripted press can be anchored to a screen rather than to a frame number.
-    PortNoteSceneEntered((int)newscene);
-
-    // PORT: and the debug menu, which had no way to name the screen it was drawn over.
+    // PORT: progress marker, see the note on. The package name is part of the line and not only of
+    // the ten-second heartbeat, because the two screens a script most wants to wait for -- the
+    // health warning and the title -- are both over before the first heartbeat names them.
     {
         char sceneLabel[64];
         BasicString<char, Detail::TempStringAllocator> sceneFile = GetFileName(newscene);
         nlSNPrintf(sceneLabel, sizeof sceneLabel, "%d  %s", (int)newscene,
                    sceneFile.c_str() != NULL ? sceneFile.c_str() : "?");
+
+        if (getenv("STRIKERS_LOG_SCENES") != NULL)
+            OSReport("[port] enter scene %s\n", sceneLabel);
+
+        // PORT: and the debug menu, which had no way to name the screen it was drawn over.
         PortOverlaySetScene(sceneLabel);
     }
 
+    // PORT: and tell the synthetic-input driver, so a scripted press can be anchored to a screen rather than to a frame number.
+    PortNoteSceneEntered((int)newscene);
+
     GetConfigBool(Config::Global(), "fev2", false);
 
     if (newscene == SCENE_MAIN_MENU)
diff --git a/smstrikers-port/src/Game/main.cpp b/smstrikers-port/src/Game/main.cpp
index d0d5ed7..02c71d4 100644
--- a/smstrikers-port/src/Game/main.cpp
+++ b/smstrikers-port/src/Game/main.cpp
@@ -19,6 +19,10 @@ extern "C" void PortDebugFrame(void);   // PORT: defined in Game.cpp
 #include <aurora/main.h>   // #define main aurora_main
 #include <aurora/event.h>
 #include <stdio.h>   // PORT: snprintf
+#include <stdlib.h>  // PORT: exit, on the iOS quit path at the end of main
+#if defined(__APPLE__)
+#include <TargetConditionals.h>  // PORT: TARGET_OS_IPHONE, for the same
+#endif
 #endif
 #include "port/benchmark.h"
 #include "port/audio.h"
@@ -892,6 +896,14 @@ int main(int argc, char* argv[])
     }
     PortBenchReport();
     aurora_shutdown();
+    // PORT: on iOS this main() is not the process entry point. UIKit calls it from the scene
+    // delegate's postFinishLaunch, so returning from it leaves the application alive with no
+    // engine behind it -- a frozen window and a destroyed GPU device rather than a quit. The
+    // engine has already been shut down on the line above, so ending the process here is what
+    // "quit" means; on the other platforms returning from main does it by itself.
+#if defined(__APPLE__) && TARGET_OS_IPHONE
+    exit(0);
+#endif
     return 0;
 #else
     for (;;)
