From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ballpad Native Port <dev@ballpad.local>
Date: Mon, 14 Sep 2026 03:04:52 -0500
Subject: [PATCH] port: rename MSL tree's placeholder `less` to msl_port::less

libc++'s <type_traits>, reached through include/port/prelude.h, now brings a
forward declaration of std::less into scope. The decomp's MSL_C++ placeholder
`struct less` in namespace std is then ambiguous at every use rather than a
plain redefinition, which breaks Game/AI/AISandbox.cpp via ScriptCaching.h.

Move the placeholder into std::msl_port and use it as the __tree/map default
comparator. The struct is empty and __tree only stores it, so the name is the
only observable difference and member layouts are unchanged.
---
 .../include/Game/AI/Scripts/ScriptCaching.h        |  4 +++-
 .../MSL_C++/MSL_Common/msl_tree.h                  | 14 ++++++++++----
 2 files changed, 13 insertions(+), 5 deletions(-)

diff --git a/smstrikers-port/include/Game/AI/Scripts/ScriptCaching.h b/smstrikers-port/include/Game/AI/Scripts/ScriptCaching.h
index a84e384..45b803f 100644
--- a/smstrikers-port/include/Game/AI/Scripts/ScriptCaching.h
+++ b/smstrikers-port/include/Game/AI/Scripts/ScriptCaching.h
@@ -11,7 +11,9 @@ extern unsigned char g_bScriptQuestionCachingUseSTD;
 
 // PORT: uintptr_t keys, the key is two pointers summed, and is 32 bits on Windows otherwise.
 typedef std::pair<const uintptr_t, FuzzyVariant> ScriptCachePair;
-typedef std::map<uintptr_t, FuzzyVariant, std::less<uintptr_t>, std::allocator<ScriptCachePair> > ScriptCacheMap;
+// PORT: std::msl_port::less, not std::less: see the note in MSL_Common/msl_tree.h. Empty, so the
+// map's layout is the one the decomp's member offsets describe.
+typedef std::map<uintptr_t, FuzzyVariant, std::msl_port::less<uintptr_t>, std::allocator<ScriptCachePair> > ScriptCacheMap;
 typedef std::__tree<ScriptCachePair, ScriptCacheMap::value_compare, std::allocator<ScriptCachePair> > ScriptCacheTree;
 
 class ScriptQuestionCache : public nlSingleton<ScriptQuestionCache>
diff --git a/smstrikers-port/include/PowerPC_EABI_Support/MSL_C++/MSL_Common/msl_tree.h b/smstrikers-port/include/PowerPC_EABI_Support/MSL_C++/MSL_Common/msl_tree.h
index 89c6c5f..96f1fc6 100644
--- a/smstrikers-port/include/PowerPC_EABI_Support/MSL_C++/MSL_Common/msl_tree.h
+++ b/smstrikers-port/include/PowerPC_EABI_Support/MSL_C++/MSL_Common/msl_tree.h
@@ -15,13 +15,19 @@ struct binary_function
 {
 };
 
-// PORT: MSVC's <type_traits> already defines std::less.
-#if !defined(_MSC_VER)
+// PORT: this placeholder is deliberately NOT named std::less. libc++'s <type_traits> (reached
+// through include/port/prelude.h) now brings a forward declaration of std::less into scope, and a
+// second declaration of that name in namespace std is ambiguous at every use, not merely a
+// redefinition. MSVC's <type_traits> defines std::less outright, which is why only that one was
+// guarded before. It has no call operator and __tree only stores it, so the name is the only thing
+// that can matter here.
+namespace msl_port
+{
 template <class T>
 struct less : public binary_function<T, T, bool>
 {
 };
-#endif
+} // namespace msl_port
 
 template <int N>
 class __red_black_tree
@@ -360,7 +366,7 @@ __tree<T, Compare, Allocator>::insert_node_at(node* p, bool leftchild, bool is_l
     return new_node;
 }
 
-template <class Key, class Value, class Compare = less<Key>, class Allocator = allocator<pair<const Key, Value> > >
+template <class Key, class Value, class Compare = msl_port::less<Key>, class Allocator = allocator<pair<const Key, Value> > >
 class map
 {
 public:
