From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chris Sotraidis <56282582+chrissotraidis@users.noreply.github.com>
Date: Tue, 15 Sep 2026 18:00:54 -0500
Subject: [PATCH] port: record the game's own state with each benchmarked frame

A frame record that carries only timings cannot answer the question doc 34's endurance
row asks, because the row is about segments: active play on one side, and the goal,
the replay and the kickoff on the other. Those stretches are decided by eGameState and
by nothing a clock can be asked afterwards, so the state is recorded per frame -- set by
cGame's own update and stored by the frame it belongs to -- and both the CSV and the
printed summary name the mix, so a run cannot report a mean over live play and a goal
sequence as if it were one thing.
---
 smstrikers-port/include/port/benchmark.h | 10 +++++
 smstrikers-port/src/Game/Game.cpp        |  5 +++
 smstrikers-port/src/platform/benchmark.c | 52 +++++++++++++++++++++++-
 3 files changed, 65 insertions(+), 2 deletions(-)

diff --git a/smstrikers-port/include/port/benchmark.h b/smstrikers-port/include/port/benchmark.h
index e2becf9..c9f03ad 100644
--- a/smstrikers-port/include/port/benchmark.h
+++ b/smstrikers-port/include/port/benchmark.h
@@ -30,6 +30,16 @@ double PortBenchElapsed(void);
 // recorded, keeping loading spikes out of the tail, and the run clock restarts here.
 void PortBenchMatchActive(void);
 
+// The eGameState the frame being recorded belongs to, as the game itself reports it: 0 pre-game,
+// 1 kickoff, 2 post-goal, 3 end of game, 4 gameplay, 5 overtime.
+//
+// Recorded per frame rather than derived afterwards, because the segments doc 34 asks a run to
+// report separately -- active gameplay on one side, the goal/replay/transition stretches on the
+// other -- are decided by that state and by nothing a clock can be asked about later. A frame
+// carries the state the simulation last set, which is the state that decided how the frame was
+// built.
+void PortBenchPhase(int state);
+
 void PortBenchFrameBegin(void);
 void PortBenchAfterTasks(void);
 void PortBenchFrameEnd(void);
diff --git a/smstrikers-port/src/Game/Game.cpp b/smstrikers-port/src/Game/Game.cpp
index 5f2478d..9681376 100644
--- a/smstrikers-port/src/Game/Game.cpp
+++ b/smstrikers-port/src/Game/Game.cpp
@@ -1155,6 +1155,11 @@ void cGame::Update(float deltaTime)
     // PORT: the benchmark discards everything before this point.
     PortBenchMatchActive();
 
+    // PORT: and records what the frame it is measuring is, by the game's own state. GS_GAMEPLAY
+    // and GS_OVERTIME are the active-play segment; the rest of a match is the goal, the replay and
+    // the kickoff, which doc 34 asks to be measured on their own.
+    PortBenchPhase((int)GetGameState());
+
     // PORT: hand the debug menu the state it cannot reach for itself.
     if ((PortOverlayMenuOpen() || PortDebugStateWanted())
         && g_pTeams[0] != NULL && g_pTeams[1] != NULL
diff --git a/smstrikers-port/src/platform/benchmark.c b/smstrikers-port/src/platform/benchmark.c
index fd91a88..760a2e4 100644
--- a/smstrikers-port/src/platform/benchmark.c
+++ b/smstrikers-port/src/platform/benchmark.c
@@ -35,6 +35,7 @@ static unsigned long long s_lastReport;
 static unsigned int s_busyUs[BENCH_CAP];
 static unsigned int s_presentUs[BENCH_CAP];
 static unsigned int s_frameUs[BENCH_CAP];
+static signed char s_phaseFrame[BENCH_CAP];   // eGameState of the frame in the same slot
 static unsigned long long s_sleepUsTotal;
 static size_t s_count;
 static size_t s_dropped;
@@ -42,6 +43,11 @@ static size_t s_skipped;          // frames before the match started
 static int s_matchActive;
 static int s_skipKickoff;         // discard the frame the match starts on
 
+// The eGameState the current frame belongs to, set by cGame's update and recorded with the frame.
+// -1 until the game says otherwise, so a row that carries -1 is one the game never classified
+// rather than one it called pre-game.
+static int s_phase = -1;
+
 // Always-on frame timing, for the overlay. Two clock reads a frame, so they are collected whether
 // or not STRIKERS_BENCHMARK is set: watching a spike during ordinary play is the case that matters.
 #define LIVE_WINDOW 256
@@ -178,6 +184,13 @@ double PortBenchElapsed(void)
     return (double)(port_monotonic_ns() - s_runStart) / 1e9;
 }
 
+// Set by cGame's update, once per simulation update, with the game's own eGameState. Read by
+// PortBenchFrameEnd and stored with the frame it belongs to.
+void PortBenchPhase(int state)
+{
+    s_phase = state;
+}
+
 void PortBenchFrameBegin(void)
 {
     s_t0 = port_monotonic_ns();
@@ -325,6 +338,7 @@ void PortBenchFrameEnd(void)
         s_busyUs[s_count] = (unsigned int)(busy / 1000ull);
         s_presentUs[s_count] = (unsigned int)(present / 1000ull);
         s_frameUs[s_count] = (unsigned int)(frame / 1000ull);
+        s_phaseFrame[s_count] = (signed char)s_phase;
         s_count++;
     }
     else
@@ -441,6 +455,39 @@ void PortBenchReport(void)
         fMean, fP50, fP95, fP99, fMax,
         sleepMean);
 
+    // What the recorded frames were, by the game's own state. The segments a run has to report
+    // separately are these values and not a clock, so a summary that printed one mean over "the
+    // match" would be reporting live play and the goal sequences as one thing.
+    {
+        size_t counts[8];
+        char line[192];
+        size_t k;
+        memset(counts, 0, sizeof counts);
+        line[0] = '\0';
+        for (k = 0; k < s_count; k++)
+        {
+            int p = (int)s_phaseFrame[k];
+            if (p >= 0 && p < 8)
+                counts[p]++;
+        }
+        for (k = 0; k < 8; k++)
+        {
+            size_t used;
+            if (counts[k] == 0)
+                continue;
+            used = strlen(line);
+            if (used > 0 && used + 16 < sizeof line)
+            {
+                line[used++] = ' ';
+                line[used] = '\0';
+            }
+            if (used + 16 < sizeof line)
+                snprintf(line + used, sizeof line - used, "%zu:%zu", k, counts[k]);
+        }
+        fprintf(stderr, "  match states    %s   (eGameState: 0 pre, 1 kickoff, 2 post-goal, "
+                        "3 end, 4 gameplay, 5 overtime)\n", line);
+    }
+
     // Headroom: how much slower a machine could be and still hold the frame rate it runs to.
     double field = 1000.0 / 59.94;
     int uncapped = 0;
@@ -507,9 +554,10 @@ static void write_csv(void)
     fprintf(f, "# build=%s", PORT_BUILD_TYPE);
     for (i = 0; i < s_labelCount; i++)
         fprintf(f, " %s=%s", s_labelKey[i], s_labelVal[i]);
-    fprintf(f, "\nframe,busy_us,present_us,frame_us\n");
+    fprintf(f, "\nframe,busy_us,present_us,frame_us,phase\n");
     for (i = 0; i < s_count; i++)
-        fprintf(f, "%zu,%u,%u,%u\n", i, s_busyUs[i], s_presentUs[i], s_frameUs[i]);
+        fprintf(f, "%zu,%u,%u,%u,%d\n", i, s_busyUs[i], s_presentUs[i], s_frameUs[i],
+                (int)s_phaseFrame[i]);
     fclose(f);
     fprintf(stderr, "[bench] wrote %zu frames to %s\n", s_count, path);
 }
